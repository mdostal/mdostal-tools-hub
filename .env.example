# Copy to .env.local for local dev, or set as Vercel project env vars for
# deployment. Every value here is optional -- omitted vars fall back to a
# generic placeholder (see src/lib/site-config.ts), so the app runs and
# builds cleanly with zero setup. Fill these in to make it yours.

# Sanity CMS backing the tool directory (see src/lib/sanity.ts). Not
# secrets -- a Sanity project ID/dataset name is meant to be public.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Site identity & branding (src/lib/site-config.ts) ---

# The GitHub account this site is "the tools directory for" -- also read by
# scripts/crawl-github-repos.mjs to know which account to scan.
NEXT_PUBLIC_GITHUB_ACCOUNT=your-github-username

# Absolute URL this site is deployed at (used for OG/Twitter metadata).
NEXT_PUBLIC_SITE_URL=https://example.com

# Short wordmark shown in the header, e.g. "tools.example".
NEXT_PUBLIC_SITE_NAME=tools.example

# <title> / OG / Twitter card title.
NEXT_PUBLIC_PAGE_TITLE=Tools

# <meta description> / OG / Twitter card description.
NEXT_PUBLIC_PAGE_DESCRIPTION=Open-source tools, built and shipped in public.

# Hero H1: "{HEADLINE} {ACCENT}" -- ACCENT renders in the accent color.
NEXT_PUBLIC_HERO_HEADLINE=Small, sharp tools.
NEXT_PUBLIC_HERO_ACCENT=Free and open.

# Hero paragraph + one-line subtext under it.
NEXT_PUBLIC_HERO_DESCRIPTION=Open-source utilities, built and shipped in public.
NEXT_PUBLIC_HERO_SUBTEXT=→ Browse the tools below. Star what helps, file issues, make them better.

# Header nav cross-links. JSON array of {label, url}. Example:
# NEXT_PUBLIC_NAV_LINKS_JSON=[{"label":"My blog →","url":"https://example.com/blog"}]
NEXT_PUBLIC_NAV_LINKS_JSON=

# Support/funding section. Heading + JSON array of {label, description?, url}.
# Example:
# NEXT_PUBLIC_SUPPORT_LINKS_JSON=[{"label":"Buy me a coffee","url":"https://buymeacoffee.com/you"}]
NEXT_PUBLIC_SUPPORT_HEADING=Support this project
NEXT_PUBLIC_SUPPORT_LINKS_JSON=

# Footer: "Built by {OWNER_NAME}. {FOOTER_TAGLINE}" + optional extra link.
NEXT_PUBLIC_OWNER_NAME=the maintainer
NEXT_PUBLIC_FOOTER_TAGLINE=
NEXT_PUBLIC_OWNER_URL=
NEXT_PUBLIC_OWNER_URL_LABEL=

# --- Server-only, never NEXT_PUBLIC_ (used only by scripts, never shipped to the browser) ---

# Write-capable Sanity token -- required only for scripts/crawl-github-repos.mjs --write
# and scripts/migrate-tools-to-sanity.mjs. Never the read-only NEXT_PUBLIC_* client.
SANITY_API_WRITE_TOKEN=

# Optional -- raises the crawler's GitHub API rate limit above 60/hr unauthenticated.
GITHUB_TOKEN=
